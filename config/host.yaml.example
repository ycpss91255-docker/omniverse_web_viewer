# omniverse_web_viewer runtime config template.
# ---------------------------------------------------------------------
# Copy to config/host.yaml (gitignored, per-host) and mount it into the
# container at /etc/host.yaml. This file is documentation only -- it is
# NOT baked into the image. Defaults live in the entrypoint
# (${VAR:-default}); a value here, or a VIEWER_UI_MODE / SIGNALING_*
# env var, overrides them. Precedence: host.yaml > env > built-in
# default. Ports (SIGNALING_PORT / MEDIA_PORT / SERVE_PORT) are workload
# runtime params delivered via env / .env (D8), NOT host.yaml.
#
# KEYS ARE READ FROM THEIR OWN SECTION ONLY. This file is by design shared
# with the other containers on the host (isaac#65), so `public_ip` is taken
# from `network:` and `ui_mode` from `viewer:`, and a key in someone else's
# section is left alone. A key written at column 0 -- outside any section --
# is not read either, and the two keys differ in what happens next:
#   public_ip at column 0 -> the entrypoint REFUSES to start and names the
#     section it belongs in. A missing `network:` section is anomalous (that
#     section is why this file is read at all), and ignoring the key would
#     mean dialling an address nobody chose, with exit 0 and HTTP 200.
#   ui_mode at column 0   -> REPORTED on stderr and ignored. A missing
#     `viewer:` section is normal (the mode usually arrives via the
#     VIEWER_UI_MODE env), so refusing would stop a correctly configured
#     viewer from booting over a key another container owns -- and this file
#     cannot tell that apart from a key meant for us and mis-indented.
# ---------------------------------------------------------------------

network:
  # Address the browser uses for the WebRTC stream (ICE candidates).
  #   127.0.0.1   -> same-machine browser only (default)
  #   <LAN IP>    -> remote browser on same network, e.g. "192.168.50.1"
  public_ip: "127.0.0.1"

viewer:
  # Which APP the entrypoint serves (D7 app selector). The image ships two
  # built apps; ui_mode picks which dist is served:
  #   "usd-viewer"  -> upstream web-viewer-sample built UNMODIFIED: the
  #                    landing / "UI Option" selection screen + full USD
  #                    Viewer UI + any-app stream, all reached interactively
  #                    by clicking (default).
  #                    WARNING: the full USD Viewer UI only works with the
  #                    kit-app-template USD Viewer. Against Isaac Sim or any
  #                    other Kit app, pick that path's "any streaming app"
  #                    option, or use "stream-only".
  #   "stream-only" -> our own full-screen auto-connect app: a bare video
  #                    stream with no chrome, connects on load (no click).
  #                    Use this for Isaac Sim or any non-USD-Viewer Kit app.
  ui_mode: "usd-viewer"
