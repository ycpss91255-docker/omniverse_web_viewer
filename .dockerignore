# Per-host runtime config: mounted into the container at /etc/host.yaml at RUN
# time, never baked in. Without this it is swept into the image by the layered
# config COPY (Dockerfile CONFIG_SRC), so one machine's host.yaml would ride
# along in a devel layer. The .example alongside it is documentation and stays.
config/host.yaml

# Same reason as .gitignore: never let a host-built .pyc into the build
# context, where `COPY script/ci/ /ci/` would ship it.
__pycache__/
*.py[cod]
# managed by template (do not remove)
.env
.env.local
.env.local.toml
.env.generated
.env.bak
.env.local.bak
env.local.toml
compose.yaml
.setup.conf.bak
setup.toml.bak
.setup.conf.local
.setup.conf.local.bak
setup.local.toml
coverage/
.Dockerfile.generated
.docker.xauth
log/
/deploy/
